---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/blog/*.mdx', { eager: true });
  return Object.values(modules).map((post: any) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, description, tags } = post.frontmatter;
const Content = post.Content;

const written = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${title} — Shruti Joshi`} description={description}>
  <article>
    <header class="mb-8">
      <a href="/blog" class="link-quiet text-sm">← Writing</a>

      <h1 class="mt-4 font-serif text-3xl font-semibold leading-tight tracking-tight text-zinc-950 dark:text-zinc-50">
        {title}
      </h1>

      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
        <time class="meta" datetime={date}>{written}</time>
        {tags?.map((tag: string) => <span class="tag">{tag}</span>)}
      </p>
    </header>

    <div class="prose prose-zinc dark:prose-invert prose-sm max-w-none
                prose-headings:font-serif prose-headings:tracking-tight
                prose-a:text-accent-700 dark:prose-a:text-accent-400
                prose-a:decoration-accent-300 dark:prose-a:decoration-accent-700
                prose-code:text-sm prose-code:bg-zinc-100 dark:prose-code:bg-zinc-800
                prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                prose-pre:!bg-zinc-950 dark:prose-pre:!bg-zinc-900
                prose-img:rounded-sm prose-img:border prose-img:border-zinc-200 dark:prose-img:border-zinc-800">
      <Content />
    </div>
  </article>
</BaseLayout>
